# Swift / SwiftPM
.build/
.swiftpm/
*.xcodeproj
DerivedData/
.DS_Store

# Vendored development-guidelines framework (managed, replaceable)
/development-guidelines/
/.claude/
/.claude/skills/

# Internal planning docs and tooling config, never published: they carry project
# names, local paths and business context that have no place in a public
# repository. They live in the private SwiftDeterminism-docs repo, reached here
# through a symlink so tooling expecting project/master_plan.md keeps working:
#
#     git clone git@github.com:jpurnell/SwiftDeterminism-docs.git
#     ln -s ../SwiftDeterminism-docs SwiftDeterminism/project
#
# No trailing slash on /project — it is a symlink, and `/project/` would match
# only a directory, leaving the link untracked-but-committable.
/project
/.quality-gate.yml

# Local secrets — never committed
.env
.env.*
*.credentials

# Emacs autosave / lock files
#*#
.#*
*~
